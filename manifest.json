{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "1.1",
  "description": "__MSG_app_description__",
  "default_locale": "pt_BR",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "tabs",
    "offscreen",
    "identity",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://izy-focus-assets.vercel.app/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "oauth2": {
    "client_id": "INSERT_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Izy Focus",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["offscreen.html"],
      "matches": ["*://*/*"]
    },
    {
      "resources": [
        "assets/sounds/rain.mp3",
        "assets/sounds/forest.mp3",
        "assets/sounds/focus_complete.mp3",
        "assets/sounds/break_complete.mp3"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
