{
  "manifest_version": 3,
  "name": "Izy Focus",
  "version": "1.0",
  "description": "Foco calmo e intencional para mentes criativas. Bloqueie distrações e cultive seu jardim de produtividade.",
  "permissions": [ "storage", "alarms", "notifications", "declarativeNetRequest", "tabs", "offscreen" ],
  "host_permissions": [ "<all_urls>" ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Izy Focus",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": { "service_worker": "background/background.js" },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [ "blocked/blocked.html" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}